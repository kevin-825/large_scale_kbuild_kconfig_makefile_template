#This is  scripts/env/build_profiles.env  file  and can be included with in bash script

#build profile number
pN=${pN:-0}

OUTPUT_BASE_DIR="/mnt/wsl/ramdisk5"

declare -A profile_0=(
    [ARCH]=riscv
    [CROSS_COMPILE]=riscv64-unknown-linux-gnu-
    [DEFCONFIG]=defconfig
    [NPROC]=9
    [V]=0
    [QEMU]=qemu-system-riscv64
    [QEMU_EXTRA_ARG]=
)

declare -A profile_1=(
    [ARCH]=arm64
    [CROSS_COMPILE]=aarch64-none-linux-gnu-
    [DEFCONFIG]=defconfig
    [NPROC]=$(nproc)
    [V]=1
    [QEMU]=qemu-system-aarch64
    [QEMU_EXTRA_ARG]=
)


print_help() {
    echo ""
    echo "Available profiles:"
    
    local i=0
    # Loop dynamically as long as target$i exists
    while declare -p "profile_$i" &>/dev/null; do
        declare -n tgt="profile_$i"
        echo "  [$i] ARCH: ${tgt[ARCH]} | DEFCONFIG: ${tgt[DEFCONFIG]}"
        echo "      -> CC:      ${tgt[CROSS_COMPILE]}"
        echo ""
        unset -n tgt
        ((++i))
    done
    
    echo ""
    echo "Example: ./build.sh 0"
}

# Validate target exists
profile_name=profile_${pN}
if ! declare -p "$profile_name" &>/dev/null; then
    echo -e "\n[ERROR] profile [$pN] does not exist.\n"
    print_help
    exit 1
fi

declare -n pBp=profile_${pN}

export ARCH="${pBp[ARCH]}"
export O="${OUTPUT_BASE_DIR}/build_${ARCH}"
SDCARD_PATH="${O}/SDcard.img"

QEMU_BASE_ARG=(
    -M virt
    -m 1024M
    -nographic
    -drive "file=${SDCARD_PATH},format=raw,id=hd0,if=none"
    -device "virtio-blk-device,drive=hd0"
    -netdev user,id=net0
    -device virtio-net-device,netdev=net0
    -append " ' root=/dev/vda2 rw rootwait console=ttyS0 earlycon=sbi '"
    --kernel ${O}/vmkxv6.elf
)

export NPROC=${pBp[NPROC]}

export CROSS_COMPILE="${pBp[CROSS_COMPILE]}" V="${pBp[V]}" NPROC="${pBp[NPROC]}"

make_args=" \
ARCH=${pBp[ARCH]} \
CROSS_COMPILE=${pBp[CROSS_COMPILE]} \
V=${pBp[V]} \
O=${OUTPUT_BASE_DIR}/build_${ARCH}"

export make_args


QEMU_CMDs="${pBp[QEMU]} ${QEMU_BASE_ARG[@]} ${pBp[QEMU_EXTRA_ARG]}"

export QEMU_CMDs
