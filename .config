
#
# Architecture Selection
#
# CONFIG_ARCH_ARM is not set
# CONFIG_ARCH_ARM64 is not set
CONFIG_ARCH_RISCV=y
CONFIG_64BIT=y
# CONFIG_BIG_ENDIAN is not set
# end of Architecture Selection

#
# RISC-V System Configuration
#
# CONFIG_ARCH_RV32I is not set
CONFIG_ARCH_RV64I=y

#
# Platform Selection
#
CONFIG_TARGET_QEMU_VIRT_64=y
# CONFIG_TARGET_SIFIVE_UNMATCHED is not set
# end of Platform Selection

#
# ISA Extensions
#
CONFIG_RISCV_ISA_M=y
CONFIG_RISCV_ISA_A=y
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_ISA_F=y
CONFIG_RISCV_ISA_D=y
CONFIG_RISCV_ISA_V=y
# end of ISA Extensions
# end of RISC-V System Configuration
